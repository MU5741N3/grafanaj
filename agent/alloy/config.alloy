// Configuración de Grafana Alloy para recopilar métricas del host y enviarlas (Push)
// hacia la central de Prometheus/Grafana

prometheus.exporter.unix "host_metrics" {
  include_exporter_metrics = false
  disable_collectors       = ["mdadm"]
}

prometheus.scrape "host_scrape" {
  targets    = prometheus.exporter.unix.host_metrics.targets
  forward_to = [prometheus.relabel.host_labels.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

// Inyección de etiquetas de identificación del host
prometheus.relabel "host_labels" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    target_label = "job"
    replacement  = "node_exporter"
  }

  rule {
    target_label = "environment"
    replacement  = "produccion"
  }

  rule {
    target_label = "instance_name"
    replacement  = coalesce(sys.env("HOSTNAME"), "maquina-cliente")
  }
}

// Envío remoto hacia la central
// Cambiar 'localhost:9090' por la dirección o IP pública/VPN de tu central
prometheus.remote_write "central" {
  endpoint {
    url = coalesce(sys.env("CENTRAL_REMOTE_WRITE_URL"), "http://localhost:9090/api/v1/write")

    // Si tu central requiere autenticación básica (opcional):
    // basic_auth {
    //   username = "usuario"
    //   password = "password"
    // }
  }
}
